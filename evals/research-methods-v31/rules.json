  "soft_rules": [
    {"code": "RD.REVIEW.EPISTEMIC_FIT", "judgment": "ontology, epistemology, paradigm, logic, and route compatibility"},
    {"code": "RD.REVIEW.QCA_THRESHOLD", "judgment": "QCA calibration and threshold justification"},
    {"code": "RD.REVIEW.SATURATION", "judgment": "grounded-theory saturation rationale"},
    {"code": "RD.REVIEW.NETWORK_DEPENDENCE", "judgment": "network dependence treatment"},
    {"code": "RD.REVIEW.DIGITAL_TRACE_COVERAGE", "judgment": "digital-trace population coverage"},
    {"code": "ME.REVIEW.QCA_THRESHOLD", "judgment": "QCA sensitivity and robustness interpretation"},
    {"code": "ME.REVIEW.SATURATION", "judgment": "execution evidence for theoretical saturation"},
    {"code": "ME.REVIEW.NETWORK_DEPENDENCE", "judgment": "dependence-aware network modeling and diagnostics"}
  ],
  "answer_quality_review_rules": [
    {
      "code": "AQ.CONTEXT.FACT_BOUNDARY",
      "judgment": "does not inject internal product names, schemas, versions, permissions, or results absent from the task or workspace"
    },
    {
      "code": "AQ.SALIENCE.DECISION_FIRST",
      "judgment": "prioritizes the few design bottlenecks that determine the answer instead of leading with a universal checklist"
    },
    {
      "code": "AQ.COVERAGE.ROUTE_CLOSURE",
      "judgment": "uses salience to order the answer without omitting task anomalies or method-specific decisions needed to close the selected route"
    },
    {
      "code": "AQ.EXECUTION.DEPLOYMENT_MATCH",
      "judgment": "matches assignment, uncertainty, data split, validation, and interpretation to the real cluster, entity, time, version, and deployment unit"
    },
    {
      "code": "AQ.DECISION.CONDITIONAL_AUDIT",
      "judgment": "uses audit-conditioned branches when a design property remains verifiable and reserves categorical rejection for established failures"
    },
    {
      "code": "AQ.REPAIR.OBJECT_PRESERVED",
      "judgment": "states whether a robustness or repair action preserves the original estimand, comparison, material universe, time order, or mechanism"
    },
    {
      "code": "AQ.INFERENCE.EVIDENCE_LADDER",
      "judgment": "maps weaker and stronger evidence combinations to explicit inference ceilings and an honest fallback deliverable"
    }
  ],
  "never_universal_hard_rules": [
    "fixed sample size",
    "fixed p-value",
    "fixed reliability or validity cutoff",
    "fixed QCA consistency, frequency, or condition count",
    "fixed theoretical saturation count",
    "method hierarchy or RCT supremacy",
    "hypotheses required for every research question"
  ]
}
