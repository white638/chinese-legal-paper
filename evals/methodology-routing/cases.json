{
  "schema_version": "avereth-methodology-routing-cases/v2",
  "registry": {
    "path": "skills/empirical-research/references/method-adapter-registry.json",
    "schema_version": "cnki-method-adapter-registry/v3",
    "registry_version": "5.1.0"
  },
  "source_manifests": {
    "research-methods-v31": {
      "path": "evals/research-methods-v31/fixture_manifest.json",
      "variants_field": "automated_variants_per_family"
    }
  },
  "harnesses": {
    "method-execution-validator": {
      "path": "evals/methodology-routing/test_methodology_routing.py",
      "test_ids": [
        "MethodologyRoutingEvalTests.test_manifest_cases_execute",
        "MethodologyRoutingEvalTests.test_family_specific_error_cases_execute"
      ]
    }
  },
  "coverage_contract": {
    "required_roles": [
      "positive",
      "error",
      "boundary",
      "inference-overreach"
    ],
    "minimum_family_specific_error_cases": 2,
    "generic_error_templates_count_toward_minimum": false,
    "family_semantic_rules": {
      "path": "skills/empirical-research/scripts/method_execution.py",
      "constant": "FAMILY_SEMANTIC_RULES"
    },
    "family_error_distinctness": [
      "failure_mode",
      "typed_mutation",
      "expected_error_codes"
    ],
    "inference_rule": "The attempted claim type must exist in the registry vocabulary and be absent from the family's claim_capabilities."
  },
  "case_templates": [
    {
      "id": "valid-complete",
      "role": "positive",
      "harness": "method-execution-validator",
      "source_manifest": "research-methods-v31",
      "source_variant": "positive",
      "mutation": {
        "operator": "none"
      },
      "expected": {
        "status": "PASS",
        "codes": []
      }
    },
    {
      "id": "repetitive-content",
      "role": "error",
      "generic": true,
      "failure_mode": "semantic-content-repetition",
      "harness": "method-execution-validator",
      "source_manifest": "research-methods-v31",
      "source_variant": "keyword-gaming",
      "mutation": {
        "operator": "replace-actions",
        "target": "runs[].actions",
        "value": [
          "执行执行执行执行执行执行"
        ]
      },
      "expected": {
        "status": "FAIL",
        "codes": [
          "ME.CONTENT.REPETITIVE"
        ]
      }
    },
    {
      "id": "missing-required-field",
      "role": "error",
      "generic": true,
      "failure_mode": "required-execution-field-absence",
      "harness": "method-execution-validator",
      "source_manifest": "research-methods-v31",
      "source_variant": "single-field-mutation",
      "mutation": {
        "operator": "remove-first-required-execution-field",
        "target": "runs[].method_fields"
      },
      "expected": {
        "status": "FAIL",
        "codes": [
          "ME.METHOD.FIELD_MISSING"
        ]
      }
    },
    {
      "id": "legal-non-applicability",
      "role": "boundary",
      "boundary_condition": "A confirmed route becomes impossible because registered material is unavailable, so the route is closed and its claim is withdrawn.",
      "harness": "method-execution-validator",
      "source_manifest": "research-methods-v31",
      "source_variant": "legal-non-applicability",
      "mutation": {
        "operator": "withdraw-route-not-applicable",
        "target": "runs[]"
      },
      "expected": {
        "status": "PASS",
        "codes": []
      }
    },
    {
      "id": "unsupported-claim",
      "role": "inference-overreach",
      "harness": "method-execution-validator",
      "source_manifest": "research-methods-v31",
      "source_variant": "inference-overreach",
      "mutation": {
        "operator": "replace-result-claim-type",
        "target": "claims[].type and runs[].results[].type",
        "value_from_family": "inference_overreach.attempted_claim_type"
      },
      "expected": {
        "status": "FAIL",
        "codes": [
          "ME.INFERENCE.CAPABILITY_EXCEEDED"
        ]
      }
    }
  ],
