{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "positive",
    "negative",
    "rejected"
  ],
  "properties": {
    "positive": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "why"
        ],
        "properties": {
          "record_id": {
            "type": "string"
          },
          "why": {
            "type": "string",
            "minLength": 20
          }
        },
        "additionalProperties": false
      }
    },
    "negative": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "why"
        ],
        "properties": {
          "record_id": {
            "type": "string"
          },
          "why": {
            "type": "string",
            "minLength": 20
          }
        },
        "additionalProperties": false
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "reason"
        ],
        "properties": {
          "record_id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 8
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
