{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avereth.local/schemas/methods/text-measurement-v1.schema.json",
  "title": "Text Measurement Artifact Contract v1",
  "type": "object",
  "required": ["construct", "unit_of_analysis", "corpus", "codebook_artifact_id", "gold_standard", "split", "validation", "sensitivity", "validity", "interpretation"],
  "properties": {
    "construct": {
      "type": "object",
      "required": ["name", "definition", "unit", "codebook_version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "codebook_version": {"type": "string", "minLength": 1}
      }
    },
    "unit_of_analysis": {"type": "string", "minLength": 1},
    "corpus": {
      "type": "object",
      "required": ["manifest_artifact_id", "frozen"],
      "properties": {
        "manifest_artifact_id": {"type": "string"},
        "frozen": {"const": true}
      }
    },
    "codebook_artifact_id": {"type": "string"},
    "gold_standard": {
      "type": "object",
      "required": ["labels_artifact_id", "sampling_strategy", "coder_count", "identity_type", "independence"],
      "properties": {
        "labels_artifact_id": {"type": "string"},
        "sampling_strategy": {"type": "string"},
        "coder_count": {"type": "integer", "minimum": 1},
        "identity_type": {"const": "human_reference"},
        "independence": {"type": "string"}
      }
    },
    "split": {
      "type": "object",
      "required": ["strategy", "grouping_unit", "train_manifest_artifact_id", "test_manifest_artifact_id"],
      "properties": {
        "strategy": {"type": "string"},
        "grouping_unit": {"type": "string"},
        "train_manifest_artifact_id": {"type": "string"},
        "test_manifest_artifact_id": {"type": "string"}
      }
    },
    "validation": {
      "type": "object",
      "required": ["predictions_artifact_id", "metrics_artifact_id", "error_analysis_artifact_id"]
    },
    "sensitivity": {
      "type": "object",
      "required": ["artifact_id", "dimensions"]
    },
    "validity": {
      "type": "object",
      "required": ["artifact_id"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1}
      }
    },
    "interpretation": {
      "type": "object",
      "required": ["allowed", "prohibited"]
    },
    "llm_run": {
      "type": "object",
      "required": ["identity_type", "model_name", "model_revision", "run_date", "system_prompt_sha256", "user_prompt_sha256", "temperature", "repeat_count", "output_schema", "retry_rule", "repeat_consistency", "human_gold_artifact_id"],
      "properties": {
        "identity_type": {"const": "llm_run"},
        "repeat_count": {"type": "integer", "minimum": 1},
        "system_prompt_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "user_prompt_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    }
  },
  "additionalProperties": true
}
