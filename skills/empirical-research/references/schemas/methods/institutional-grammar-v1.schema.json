{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avereth.local/schemas/methods/institutional-grammar-v1.schema.json",
  "title": "Institutional Grammar and Clause Matching Contract v1",
  "type": "object",
  "required": ["clause_unit", "grammar_fields", "match_categories", "ambiguity_policy", "parsed_clauses_artifact_id", "clause_matches_artifact_id", "ambiguity_review_artifact_id", "sensitivity_artifact_id"],
  "properties": {
    "clause_unit": {"type": "string", "minLength": 1},
    "grammar_fields": {"type": "array", "minItems": 8, "uniqueItems": true},
    "match_categories": {"type": "array", "minItems": 1, "uniqueItems": true},
    "ambiguity_policy": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
