{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avereth.local/schemas/methods/causal-design-v1.schema.json",
  "title": "Estimand-First Causal Design Contract v1",
  "type": "object",
  "required": ["estimand", "unit_of_treatment", "unit_of_analysis", "independence_unit", "counterfactual", "identification_assumptions", "estimate_artifact_id", "sensitivity_artifact_id"],
  "properties": {
    "estimand": {"$ref": "#/$defs/estimand"},
    "unit_of_treatment": {"type": "string", "minLength": 1},
    "unit_of_analysis": {"type": "string", "minLength": 1},
    "independence_unit": {"type": "string", "minLength": 1},
    "counterfactual": {
      "type": "object",
      "required": ["comparison_state", "comparison_population", "time_basis"]
    },
    "identification_assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "diagnostic_artifact_id", "status"]
      }
    },
    "estimate_artifact_id": {"type": "string"},
    "sensitivity_artifact_id": {"type": "string"}
  },
  "$defs": {
    "estimand": {
      "type": "object",
      "required": ["quantity", "population", "contrast", "time_horizon"],
      "properties": {
        "quantity": {"type": "string", "minLength": 1},
        "population": {"type": "string", "minLength": 1},
        "contrast": {"type": "string", "minLength": 1},
        "time_horizon": {"type": "string", "minLength": 1}
      }
    }
  },
  "additionalProperties": true
}
