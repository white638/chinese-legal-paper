{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avereth.local/schemas/methods/text-measurement-v2.schema.json",
  "title": "Model-Researcher Text Measurement Artifact Contract v2",
  "type": "object",
  "required": ["construct", "unit_of_analysis", "corpus", "codebook_artifact_id", "reference_standard", "split", "validation", "sensitivity", "validity", "interpretation", "researcher_run"],
  "properties": {
    "construct": {
      "type": "object",
      "required": ["name", "definition", "unit", "codebook_version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "codebook_version": {"type": "string", "minLength": 1}
      }
    },
    "unit_of_analysis": {"type": "string", "minLength": 1},
    "corpus": {
      "type": "object",
      "required": ["manifest_artifact_id", "frozen"],
      "properties": {
        "manifest_artifact_id": {"type": "string"},
        "frozen": {"const": true}
      }
    },
    "codebook_artifact_id": {"type": "string"},
    "reference_standard": {
      "type": "object",
      "required": ["labels_artifact_id", "sampling_strategy", "run_count", "reference_basis", "metric_semantics", "reference_run_ids", "independence", "frozen_at", "run_manifest_artifact_id", "evidence_artifact_id", "review_artifact_id"],
      "properties": {
        "labels_artifact_id": {"type": "string"},
        "sampling_strategy": {"type": "string"},
        "run_count": {"type": "integer", "minimum": 1},
        "reference_basis": {"enum": ["independent_model_review", "same_model_repeat", "external_benchmark", "rule_verified", "mixed_evidence"]},
        "metric_semantics": {"enum": ["reference_agreement", "external_accuracy", "stability"]},
        "reference_run_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "independence": {"type": "string"},
        "frozen_at": {"type": "string", "minLength": 10},
        "run_manifest_artifact_id": {"type": "string"},
        "evidence_artifact_id": {"type": "string"},
        "review_artifact_id": {"type": "string"}
      }
    },
    "split": {
      "type": "object",
      "required": ["strategy", "grouping_unit", "train_manifest_artifact_id", "test_manifest_artifact_id"],
      "properties": {
        "strategy": {"type": "string"},
        "grouping_unit": {"type": "string"},
        "train_manifest_artifact_id": {"type": "string"},
        "test_manifest_artifact_id": {"type": "string"}
      }
    },
    "validation": {
      "type": "object",
      "required": ["predictions_artifact_id", "metrics_artifact_id", "error_analysis_artifact_id"]
    },
    "sensitivity": {
      "type": "object",
      "required": ["artifact_id", "dimensions"]
    },
    "validity": {
      "type": "object",
      "required": ["artifact_id"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1}
      }
    },
    "interpretation": {
      "type": "object",
      "required": ["allowed", "prohibited"]
    },
    "researcher_run": {
      "type": "object",
      "required": ["run_id", "context_id", "model_name", "model_revision", "run_date", "system_prompt_sha256", "user_prompt_sha256", "temperature", "repeat_count", "output_schema", "retry_rule", "repeat_consistency", "reference_labels_artifact_id", "evidence_trace_artifact_id", "independent_review_artifact_id"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "context_id": {"type": "string", "minLength": 1},
        "repeat_count": {"type": "integer", "minimum": 1},
        "system_prompt_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "user_prompt_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "reference_labels_artifact_id": {"type": "string"},
        "evidence_trace_artifact_id": {"type": "string"},
        "independent_review_artifact_id": {"type": "string"}
      }
    }
  },
  "additionalProperties": true
}
