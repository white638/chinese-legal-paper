{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avereth.local/schemas/method-operation-v1.schema.json",
  "title": "Avereth Method Operation Profile v1",
  "type": "object",
  "required": [
    "schema_version",
    "family",
    "required_operation_kinds",
    "required_artifact_roles",
    "minimum_viable_run",
    "completion_predicates",
    "failure_routes",
    "maturity_evidence"
  ],
  "properties": {
    "schema_version": {"const": "method-operation/v1"},
    "family": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "required_operation_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "optional_operation_kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "required_artifact_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "minimum_viable_run": {
      "type": "object",
      "required": ["profile_id", "required_operation_kinds", "acceptance_dimensions"],
      "properties": {
        "profile_id": {"type": "string"},
        "required_operation_kinds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "acceptance_dimensions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "completion_predicates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "failure_routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "route"],
        "properties": {"code": {"type": "string"}, "route": {"type": "string"}}
      }
    },
    "judgment_nodes": {"type": "array", "items": {"type": "string"}},
    "maturity_evidence": {
      "type": "object",
      "required": ["validator", "positive_case", "negative_case", "worked_example", "end_to_end_eval"],
      "properties": {
        "validator": {"type": ["string", "null"]},
        "positive_case": {"type": ["object", "null"]},
        "negative_case": {"type": ["object", "null"]},
        "worked_example": {"type": ["object", "null"]},
        "end_to_end_eval": {"type": ["string", "null"]}
      }
    }
  },
  "additionalProperties": true
}
