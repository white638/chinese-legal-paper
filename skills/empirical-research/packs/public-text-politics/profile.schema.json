{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avereth.local/schemas/public-text-politics-profile-v1.schema.json",
  "title": "Avereth public-text-politics method profile",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "title_zh",
    "purpose",
    "core_method_families",
    "core_claim_capability_refs",
    "core_method_contract_id",
    "core_method_contract_schema",
    "profile_contract_schema",
    "artifact_roles",
    "machine_checks",
    "researcher_judgments",
    "interpretation_boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "avereth-public-text-politics-profile/v1"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]+$"
    },
    "title_zh": {
      "type": "string",
      "minLength": 2
    },
    "purpose": {
      "type": "string",
      "minLength": 20
    },
    "core_method_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "complementary_method_families": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "core_claim_capability_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[.][.]/[.][.]/references/method-adapter-registry[.]json#/claim_capabilities/[a-z_]+$"
      }
    },
    "core_method_contract_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*/[a-z0-9-]+$"
    },
    "core_method_contract_schema": {
      "type": "string",
      "pattern": "^[.][.]/[.][.]/references/schemas/methods/[a-z0-9-]+[.]schema[.]json$"
    },
    "profile_contract_schema": {
      "type": "string",
      "pattern": "^[.][.]/contracts/[a-z_]+[.]schema[.]json$"
    },
    "artifact_roles": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]+$"
      }
    },
    "machine_checks": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "check_kind", "inputs", "failure_code"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]+$"
          },
          "check_kind": {
            "enum": [
              "artifact_exists_and_hash_matches",
              "artifact_set_disjoint",
              "grouped_split_integrity",
              "metrics_recompute",
              "class_coverage",
              "run_provenance_integrity",
              "timestamp_direction",
              "template_confound_audit",
              "common_source_audit",
              "threshold_sensitivity",
              "family_identity_uniqueness",
              "event_sequence_consistency",
              "censoring_consistency",
              "effective_sample_unit",
              "component_completeness",
              "category_coverage",
              "dimension_separation",
              "source_independence",
              "mechanism_rival_matrix",
              "silence_semantics",
              "tuple_shape",
              "entity_resolution",
              "position_validation",
              "network_dependence",
              "core_contract_reference",
              "unit_alignment",
              "development_estimation_separation",
              "measurement_error_sensitivity",
              "inference_ceiling_binding"
            ]
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "failure_code": {
            "type": "string",
            "pattern": "^PTP[.][A-Z0-9_.]+$"
          }
        },
        "additionalProperties": false
      }
    },
    "researcher_judgments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "interpretation_boundaries": {
      "type": "object",
      "required": ["allowed", "prohibited"],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 5}
        },
        "prohibited": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 5}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
