{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avereth.local/schemas/public-text-politics/text-in-causal-design-v1.schema.json",
  "title": "Text in causal design supplemental profile contract",
  "x-profile-contract-role": "supplement-over-core-method-contract",
  "x-core-method-contract-id": "causal-design/v1",
  "type": "object",
  "required": ["schema_version", "profile_id", "text_role", "units", "measurement", "data_separation", "causal_design", "results", "core_inference_result", "interpretation"],
  "properties": {
    "schema_version": {"const": "avereth-public-text-politics/text-in-causal-design/v1"},
    "profile_id": {"const": "text_in_causal_design"},
    "text_role": {"enum": ["outcome", "treatment", "matching_variable", "control_variable", "mechanism_evidence"]},
    "units": {
      "type": "object",
      "required": ["treatment_level", "text_analysis_unit", "effective_sample_unit", "cluster_level"],
      "properties": {
        "treatment_level": {"type": "string", "minLength": 2},
        "text_analysis_unit": {"type": "string", "minLength": 2},
        "effective_sample_unit": {"type": "string", "minLength": 2, "x-error-code": "PTP.CAUSAL.EFFECTIVE_N"},
        "cluster_level": {"type": "string", "minLength": 2}
      },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "required": ["contract_ref", "error_sensitivity"],
      "properties": {
        "contract_ref": {"$ref": "#/$defs/artifact"},
        "error_sensitivity": {"$ref": "#/$defs/artifact", "x-error-code": "PTP.CAUSAL.MEASUREMENT_ERROR"}
      },
      "additionalProperties": false
    },
    "data_separation": {
      "type": "object",
      "required": ["development_manifest", "effect_estimation_manifest", "overlap_disposition"],
      "properties": {
        "development_manifest": {"$ref": "#/$defs/artifact"},
        "effect_estimation_manifest": {"$ref": "#/$defs/artifact"},
        "overlap_disposition": {"enum": ["disjoint", "exploratory_only"], "x-error-code": "PTP.CAUSAL.DATA_OVERLAP"}
      },
      "additionalProperties": false
    },
    "causal_design": {
      "type": "object",
      "required": ["estimand_ref", "counterfactual_ref", "identification_diagnostics"],
      "properties": {
        "estimand_ref": {"$ref": "#/$defs/core_ref", "x-error-code": "PTP.CAUSAL.CORE_CONTRACT_REF"},
        "counterfactual_ref": {"$ref": "#/$defs/core_ref", "x-error-code": "PTP.CAUSAL.CORE_CONTRACT_REF"},
        "identification_diagnostics": {"$ref": "#/$defs/artifact"}
      },
      "additionalProperties": false
    },
    "results": {
      "type": "object",
      "required": ["model_output", "claim_ledger"],
      "properties": {
        "model_output": {"$ref": "#/$defs/artifact"},
        "claim_ledger": {"$ref": "#/$defs/artifact"}
      },
      "additionalProperties": false
    },
    "core_inference_result": {"$ref": "#/$defs/artifact", "x-error-code": "PTP.CAUSAL.INFERENCE_OVERREACH"},
    "interpretation": {"$ref": "#/$defs/interpretation"}
  },
  "$defs": {
    "artifact": {
      "type": "string",
      "pattern": "^ART-[A-Z0-9][A-Z0-9_-]*$",
      "x-error-code": "PTP.ARTIFACT.ID"
    },
    "core_ref": {
      "type": "string",
      "pattern": "^research_design[.]json#/design/routes/[0-9]+/(estimand_or_target|comparison_basis)$",
      "x-error-code": "PTP.CAUSAL.CORE_CONTRACT_REF"
    },
    "interpretation": {
      "type": "object",
      "required": ["allowed", "prohibited"],
      "properties": {
        "allowed": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
        "prohibited": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
