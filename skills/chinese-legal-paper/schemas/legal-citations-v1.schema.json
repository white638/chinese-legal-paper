{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chinese-legal-paper:citations:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "legal-citations/v1"
    },
    "manuscript": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "style": {
      "type": "string",
      "enum": [
        "working-footnote-v1",
        "journal-supplied"
      ]
    },
    "style_basis": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "citation_id": {
            "type": "string",
            "pattern": "^CIT-[A-Za-z0-9_-]+$"
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "version_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "manuscript_span": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "sha256",
              "start",
              "end",
              "quote"
            ],
            "additionalProperties": false
          },
          "evidence": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "sha256",
              "start",
              "end",
              "quote"
            ],
            "additionalProperties": false
          },
          "locator": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "printed_page",
                  "pdf_page",
                  "article",
                  "paragraph",
                  "section"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "verification": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "pending",
                      "verified"
                    ]
                  },
                  "reviewer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reviewed_at": {
                    "type": "string",
                    "format": "date"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "basis": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "status",
                  "reviewer",
                  "reviewed_at",
                  "reason",
                  "basis"
                ],
                "additionalProperties": false
              },
              "printed_page": {
                "type": "string",
                "minLength": 1
              },
              "pdf_page": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "kind",
              "label",
              "verification"
            ],
            "additionalProperties": false
          },
          "mode": {
            "type": "string",
            "enum": [
              "quotation",
              "paraphrase",
              "secondary"
            ]
          },
          "support_review": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "verified"
                ]
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "string",
                "format": "date"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "binding_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "status",
              "reviewer",
              "reviewed_at",
              "reason",
              "binding_digest"
            ],
            "additionalProperties": false
          },
          "original_source_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "citation_id",
          "source_id",
          "version_id",
          "claim_id",
          "manuscript_span",
          "evidence",
          "locator",
          "mode",
          "support_review"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "manuscript",
    "style",
    "entries"
  ],
  "additionalProperties": false
}
