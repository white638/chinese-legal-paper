{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "avereth-discovery-brief-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "public_query_authorized",
    "question",
    "partitions"
  ],
  "properties": {
    "schema_version": {
      "const": "avereth-discovery-brief/v1"
    },
    "public_query_authorized": {
      "const": true
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "partitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "id",
          "objective",
          "purpose",
          "queries",
          "tool"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "purpose": {
            "enum": [
              "nearest_neighbor",
              "counterevidence",
              "coverage_gap"
            ]
          },
          "queries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "tool": {
            "enum": [
              "exa.search",
              "web.search"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
