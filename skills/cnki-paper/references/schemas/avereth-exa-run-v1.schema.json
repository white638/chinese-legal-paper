{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper1.local/schemas/avereth-exa-run-v1.schema.json",
  "title": "Avereth Exa discovery run v1",
  "type": "object",
  "required": ["schema_version", "query_id", "purpose", "workstream", "query", "executed_at", "tool", "results_reviewed", "results"],
  "properties": {
    "schema_version": {"const": "avereth-exa-run/v1"},
    "query_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"},
    "purpose": {"enum": ["venue", "sota", "collision", "terminology", "citation", "other"]},
    "workstream": {"type": "string", "minLength": 1},
    "query": {"type": "string", "minLength": 1},
    "executed_at": {"type": "string", "format": "date-time"},
    "tool": {"type": "string", "minLength": 1},
    "results_reviewed": {"type": "integer", "minimum": 0},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rank", "title", "url", "highlights", "content_fetch", "citation_scope"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "author": {"type": "string"},
          "published_at": {"type": "string"},
          "highlights": {"type": "array", "items": {"type": "string"}},
          "content_fetch": {"enum": ["not-fetched", "fetched", "failed"]},
          "citation_scope": {"const": "candidate-only"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
