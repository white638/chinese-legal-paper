{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "avereth-review-findings-v3.schema.json",
  "title": "Avereth cross-cycle Review Finding Registry v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "review_run_id", "root_review_run_id", "status", "manuscript",
    "input_digests", "venue_contract", "provenance", "source_reviews", "findings"
  ],
  "properties": {
    "schema_version": {"const": "avereth-review-findings/v3"},
    "review_run_id": {"type": "string", "pattern": "^REV-[A-F0-9]{16}$"},
    "root_review_run_id": {"type": "string", "pattern": "^REV-[A-F0-9]{16}$"},
    "status": {"enum": ["HAS_FINDINGS", "NO_MATERIAL_OBJECTIONS"]},
    "manuscript": {"$ref": "#/$defs/fileIdentity"},
    "input_digests": {"type": "object", "additionalProperties": {"type": "string"}},
    "venue_contract": {"type": "object"},
    "provenance": {"type": "object"},
    "source_reviews": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "fileIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "idList": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "finding_id", "finding_key", "first_seen_run_id", "last_seen_cycle_id",
        "materiality", "discovery_class", "lineage", "occurrences", "source",
        "severity", "confidence", "category", "manuscript_locator", "identity_mapping",
        "problem", "reader_consequence", "recommended_action"
      ],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^REV-(MET|CON|CLR)-[0-9]{3}$"},
        "finding_key": {"type": "string", "pattern": "^RFK-[A-F0-9]{24}$"},
        "first_seen_run_id": {"type": "string", "pattern": "^REV-[A-F0-9]{16}$"},
        "last_seen_cycle_id": {"type": ["string", "null"], "pattern": "^RC-[0-9]{3}$"},
        "materiality": {"enum": ["BLOCKING", "NON_BLOCKING"]},
        "discovery_class": {"enum": ["BASELINE", "UNRESOLVED_EXISTING", "REVISION_REGRESSION", "NEW_MATERIAL", "OPTIONAL_POLISH"]},
        "lineage": {
          "type": "object", "additionalProperties": false,
          "required": ["same_as", "refines", "caused_by_batch", "reopened_from"],
          "properties": {
            "same_as": {"type": ["string", "null"]},
            "refines": {"type": ["string", "null"]},
            "caused_by_batch": {"type": ["string", "null"]},
            "reopened_from": {"type": ["string", "null"]}
          }
        },
        "occurrences": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["run_id", "cycle_id", "reviewer_role", "output_path", "output_sha256", "source_block_sha256", "manuscript_unit_id", "location"],
            "properties": {
              "run_id": {"type": "string", "minLength": 1},
              "cycle_id": {"type": ["string", "null"]},
              "reviewer_role": {"enum": ["methods", "contribution", "clarity"]},
              "output_path": {"type": "string", "minLength": 1},
              "output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "source_block_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "manuscript_unit_id": {"type": "string", "pattern": "^MSU-[A-F0-9]{16}$"},
              "location": {"type": "string", "minLength": 1}
            }
          }
        },
        "source": {"type": "object"},
        "severity": {"enum": ["CRITICAL", "MAJOR", "MINOR", "OBSERVATION"]},
        "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "category": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "manuscript_locator": {
          "type": "object", "additionalProperties": false,
          "required": ["location", "quoted_span", "quoted_span_sha256", "manuscript_unit_id"],
          "properties": {
            "location": {"type": "string", "minLength": 1},
            "quoted_span": {"type": "string", "minLength": 1},
            "quoted_span_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "manuscript_unit_id": {"type": "string", "pattern": "^MSU-[A-F0-9]{16}$"}
          }
        },
        "identity_mapping": {"type": "object"},
        "problem": {"type": "string", "minLength": 1},
        "reader_consequence": {"type": "string", "minLength": 1},
        "recommended_action": {"type": "object"}
      }
    }
  }
}
