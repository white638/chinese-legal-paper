{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cnki-paper.local/schemas/cnki-research-design-v1.schema.json",
  "title": "CNKI-Paper Research Design Contract v1",
  "description": "Portable structural contract. research_design.py remains authoritative for workspace, registry, stage, and cross-artifact semantics.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "research_question",
    "knowledge_state",
    "epistemic_position",
    "design",
    "concepts",
    "claims",
    "evidence",
    "framework",
    "alternatives",
    "falsification_conditions"
  ],
  "properties": {
    "schema_version": {
      "const": "cnki-research-design/v1"
    },
    "status": {
      "enum": [
        "confirmed",
        "draft",
        "needs-review"
      ]
    },
    "research_question": {
      "$ref": "#/$defs/research_question"
    },
    "knowledge_state": {
      "type": "object",
      "required": [
        "known",
        "unknown",
        "gap_authenticity",
        "maturity",
        "expected_contribution"
      ],
      "properties": {
        "known": {
          "$ref": "#/$defs/nonempty"
        },
        "unknown": {
          "$ref": "#/$defs/nonempty"
        },
        "gap_authenticity": {
          "$ref": "#/$defs/nonempty"
        },
        "maturity": {
          "$ref": "#/$defs/nonempty"
        },
        "expected_contribution": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "epistemic_position": {
      "type": "object",
      "required": [
        "paradigm",
        "research_logic",
        "method_rationale"
      ],
      "properties": {
        "paradigm": {
          "$ref": "#/$defs/nonempty"
        },
        "research_logic": {
          "enum": [
            "inductive",
            "deductive",
            "abductive",
            "mixed"
          ]
        },
        "method_rationale": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "design": {
      "$ref": "#/$defs/design"
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/design_object"
      },
      "default": []
    },
    "propositions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/design_object"
      },
      "default": []
    },
    "framework": {
      "type": "object",
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
        },
        "description": {
          "$ref": "#/$defs/nonempty"
        },
        "origin": {
          "type": "string"
        }
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "discriminating_evidence"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "text": {
            "$ref": "#/$defs/nonempty"
          },
          "discriminating_evidence": {
            "$ref": "#/$defs/nonempty"
          }
        }
      }
    },
    "falsification_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "condition",
          "response"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "condition": {
            "$ref": "#/$defs/nonempty"
          },
          "response": {
            "$ref": "#/$defs/nonempty"
          }
        }
      }
    },
    "sampling": {
      "type": "object"
    },
    "routes": {
      "type": "object",
      "properties": {
        "quantitative_causal": {
          "$ref": "#/$defs/quantitative_causal"
        },
        "case_process": {
          "$ref": "#/$defs/case_process"
        },
        "text_content": {
          "$ref": "#/$defs/text_content"
        },
        "descriptive": {
          "type": "object"
        },
        "interpretive": {
          "type": "object"
        },
        "theory_generation": {
          "type": "object"
        },
        "normative": {
          "type": "object"
        },
        "review": {
          "type": "object"
        }
      }
    },
    "artifact_fingerprints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/nonempty"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        }
      }
    },
    "reporting": {
      "type": "object"
    },
    "migration": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "design": {
            "properties": {
              "family": {
                "const": "quantitative_causal"
              }
            },
            "required": [
              "family"
            ]
          }
        }
      },
      "then": {
        "required": [
          "sampling",
          "routes"
        ],
        "properties": {
          "routes": {
            "required": [
              "quantitative_causal"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design": {
            "properties": {
              "family": {
                "const": "case_process"
              }
            },
            "required": [
              "family"
            ]
          }
        }
      },
      "then": {
        "required": [
          "routes"
        ],
        "properties": {
          "routes": {
            "required": [
              "case_process"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design": {
            "properties": {
              "family": {
                "const": "text_content"
              }
            },
            "required": [
              "family"
            ]
          }
        }
      },
      "then": {
        "required": [
          "routes"
        ],
        "properties": {
          "routes": {
            "required": [
              "text_content"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{1,31}$"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "id_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "design_object": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string"
        },
        "concept_ids": {
          "$ref": "#/$defs/id_refs"
        },
        "evidence_ids": {
          "$ref": "#/$defs/id_refs"
        },
        "source_ids": {
          "$ref": "#/$defs/source_ids"
        }
      }
    },
    "research_question": {
      "type": "object",
      "required": [
        "id",
        "text",
        "primary_type",
        "otipr",
        "task_fields"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "$ref": "#/$defs/nonempty"
        },
        "primary_type": {
          "enum": [
            "descriptive",
            "explanatory",
            "predictive",
            "operational",
            "normative"
          ]
        },
        "answer_task": {
          "type": "string"
        },
        "otipr": {
          "type": "object",
          "required": [
            "object",
            "time",
            "issue",
            "perspective",
            "relation"
          ],
          "properties": {
            "object": {
              "$ref": "#/$defs/nonempty"
            },
            "time": {
              "$ref": "#/$defs/nonempty"
            },
            "issue": {
              "$ref": "#/$defs/nonempty"
            },
            "perspective": {
              "$ref": "#/$defs/nonempty"
            },
            "relation": {
              "type": "object",
              "required": [
                "strength",
                "statement"
              ],
              "properties": {
                "strength": {
                  "enum": [
                    "strong",
                    "weak"
                  ]
                },
                "statement": {
                  "$ref": "#/$defs/nonempty"
                }
              }
            }
          }
        },
        "task_fields": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "primary_type": {
                "const": "descriptive"
              }
            }
          },
          "then": {
            "properties": {
              "task_fields": {
                "required": [
                  "descriptive_increment",
                  "reconstruction_boundary"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "primary_type": {
                "const": "explanatory"
              }
            }
          },
          "then": {
            "properties": {
              "task_fields": {
                "required": [
                  "relation",
                  "discriminating_expectations"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "primary_type": {
                "const": "predictive"
              }
            }
          },
          "then": {
            "properties": {
              "task_fields": {
                "required": [
                  "forecast_target",
                  "horizon",
                  "baseline",
                  "uncertainty",
                  "validation",
                  "updating"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "primary_type": {
                "const": "operational"
              }
            }
          },
          "then": {
            "properties": {
              "task_fields": {
                "required": [
                  "actor",
                  "goal",
                  "constraints",
                  "levers",
                  "feasibility",
                  "evaluation"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "primary_type": {
                "const": "normative"
              }
            }
          },
          "then": {
            "properties": {
              "task_fields": {
                "required": [
                  "normative_premises",
                  "strongest_objection",
                  "institutional_constraints"
                ]
              }
            }
          }
        }
      ]
    },
    "design": {
      "type": "object",
      "required": [
        "id",
        "family",
        "claim_type",
        "empirical",
        "method",
        "method_rationale",
        "units",
        "time_scope",
        "inference_ceiling",
        "evidence_boundary",
        "limitations",
        "permissions",
        "ethics",
        "reproducibility",
        "evidence_separation",
        "artifact_paths"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "family": {
          "enum": [
            "quantitative_causal",
            "case_process",
            "text_content",
            "descriptive",
            "interpretive",
            "theory_generation",
            "normative",
            "review"
          ]
        },
        "claim_type": {
          "enum": [
            "descriptive",
            "association",
            "causal_effect",
            "causal_mechanism",
            "prediction",
            "operational",
            "interpretive",
            "theory_generation",
            "normative",
            "review_synthesis"
          ]
        },
        "empirical": {
          "type": "boolean"
        },
        "method": {
          "$ref": "#/$defs/nonempty"
        },
        "method_rationale": {
          "$ref": "#/$defs/nonempty"
        },
        "units": {
          "$ref": "#/$defs/nonempty"
        },
        "time_scope": {
          "$ref": "#/$defs/nonempty"
        },
        "inference_ceiling": {
          "$ref": "#/$defs/nonempty"
        },
        "evidence_boundary": {
          "$ref": "#/$defs/nonempty"
        },
        "limitations": {
          "$ref": "#/$defs/nonempty"
        },
        "permissions": {
          "type": "object",
          "required": [
            "status"
          ]
        },
        "ethics": {
          "type": "object",
          "required": [
            "status"
          ]
        },
        "reproducibility": {
          "type": "object",
          "required": [
            "status"
          ]
        },
        "evidence_separation": {
          "type": "object",
          "required": [
            "status"
          ]
        },
        "reporting_plan": {
          "type": "object"
        },
        "artifact_paths": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "family": {
                "enum": [
                  "quantitative_causal",
                  "case_process",
                  "text_content"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "empirical": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "concept": {
      "type": "object",
      "required": [
        "id",
        "name",
        "definition",
        "boundary",
        "source_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/nonempty"
        },
        "definition": {
          "$ref": "#/$defs/nonempty"
        },
        "boundary": {
          "$ref": "#/$defs/nonempty"
        },
        "source_ids": {
          "$ref": "#/$defs/source_ids"
        },
        "operationalization": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "measurement": {
          "type": "object"
        }
      }
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "text",
        "type",
        "concept_ids",
        "evidence_ids",
        "source_ids",
        "allowed_scope",
        "prohibited_scope"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "$ref": "#/$defs/nonempty"
        },
        "type": {
          "enum": [
            "descriptive",
            "association",
            "causal_effect",
            "causal_mechanism",
            "prediction",
            "operational",
            "interpretive",
            "theory_generation",
            "normative",
            "review_synthesis"
          ]
        },
        "concept_ids": {
          "$ref": "#/$defs/id_refs"
        },
        "evidence_ids": {
          "$ref": "#/$defs/id_refs"
        },
        "source_ids": {
          "$ref": "#/$defs/source_ids"
        },
        "allowed_scope": {
          "$ref": "#/$defs/nonempty"
        },
        "prohibited_scope": {
          "$ref": "#/$defs/nonempty"
        },
        "status": {
          "enum": [
            "active",
            "inactive",
            "superseded",
            "withdrawn"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "description",
        "source_ids",
        "location",
        "time_scope",
        "supports_claim_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "$ref": "#/$defs/nonempty"
        },
        "description": {
          "$ref": "#/$defs/nonempty"
        },
        "source_ids": {
          "$ref": "#/$defs/source_ids"
        },
        "location": {
          "$ref": "#/$defs/nonempty"
        },
        "time_scope": {
          "$ref": "#/$defs/nonempty"
        },
        "supports_claim_ids": {
          "$ref": "#/$defs/id_refs"
        }
      }
    },
    "quantitative_causal": {
      "type": "object",
      "required": [
        "estimand",
        "temporal_order",
        "comparison_or_counterfactual",
        "identification_assumptions",
        "diagnostics",
        "robustness",
        "uncertainty"
      ]
    },
    "case_process": {
      "type": "object",
      "required": [
        "case_selection",
        "timeline",
        "mechanism_nodes",
        "evidence_diagnosticity",
        "competing_mechanisms",
        "negative_evidence",
        "scope_conditions"
      ]
    },
    "text_content": {
      "type": "object",
      "required": [
        "corpus_manifest",
        "unit_of_analysis",
        "versions_and_preprocessing",
        "codebook",
        "reliability_or_model_validation",
        "context_boundary"
      ]
    }
  }
}
