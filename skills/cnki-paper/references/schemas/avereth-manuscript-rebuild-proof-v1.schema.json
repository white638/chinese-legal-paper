{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avereth.local/schemas/avereth-manuscript-rebuild-proof-v1.schema.json",
  "title": "Avereth Per-Move Rebuild Proof v1",
  "description": "Transient compound build proof for a stale MIR closure. Every Move carries the exact ProsePacket, Writer draft, Clarity draft and ledger. Semantic Moves additionally require the independent Semantic Fidelity dispatch/assurance chain; explicit verbatim Moves instead require exact current authority text. Runtime validation enforces these mode-specific evidence kinds, Move reader/Claim semantics, unique evidence paths, and canonical-manuscript realization. It is not a scientific authority, stage receipt, or completion authority.",
  "type": "object",
  "required": [
    "schema_version",
    "control_plane",
    "owner_stage",
    "authority_class",
    "recorded_at",
    "contract_sha256",
    "authority_digest",
    "ir_source_digest",
    "manuscript_binding",
    "stale_move_refs",
    "items"
  ],
  "properties": {
    "schema_version": {"const": "avereth-manuscript-rebuild-proof/v1"},
    "control_plane": {"const": "cnki-paper"},
    "owner_stage": {"const": "build"},
    "authority_class": {"const": "transient_build_proof"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "authority_digest": {"$ref": "#/$defs/sha256"},
    "ir_source_digest": {"$ref": "#/$defs/sha256"},
    "manuscript_binding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "stale_move_refs": {"$ref": "#/$defs/nonempty_unique_refs"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nonempty_unique_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^MOVE-[A-Z0-9][A-Z0-9-]*$"}
    },
    "item": {
      "type": "object",
      "required": [
        "move_ref",
        "section_ref",
        "move_source_digest",
        "evidence_items",
        "contract_sha256",
        "authority_digest",
        "manuscript_sha256"
      ],
      "properties": {
        "move_ref": {"type": "string", "pattern": "^MOVE-[A-Z0-9][A-Z0-9-]*$"},
        "section_ref": {"type": "string", "pattern": "^SEC-[A-Z0-9][A-Z0-9-]*$"},
        "move_source_digest": {"$ref": "#/$defs/sha256"},
        "evidence_items": {
          "type": "array",
          "minItems": 4,
          "description": "Runtime requires four base evidence kinds for explicit verbatim Moves and all six kinds including semantic dispatch/assurance for semantic Moves.",
          "items": {"$ref": "#/$defs/evidence"}
        },
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "authority_digest": {"$ref": "#/$defs/sha256"},
        "manuscript_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["evidence_kind", "evidence_path", "evidence_sha256"],
      "properties": {
        "evidence_kind": {"enum": ["prose_packet", "writer_draft", "clarity_draft", "clarity_ledger", "semantic_dispatch", "semantic_assurance", "section_output"]},
        "evidence_path": {"type": "string", "pattern": "^\\.avereth-prose/"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
