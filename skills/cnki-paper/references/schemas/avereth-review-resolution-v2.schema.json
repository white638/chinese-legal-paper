{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "avereth-review-resolution-v2.schema.json",
  "title": "Avereth Review Resolution v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "review_run_id", "findings_sha256", "status", "resolutions",
    "revision_batches", "review_cycles", "optional_backlog", "convergence"
  ],
  "properties": {
    "schema_version": {"const": "avereth-review-resolution/v2"},
    "review_run_id": {"type": "string", "pattern": "^REV-[A-F0-9]{16}$"},
    "findings_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["ACTIVE", "CLOSED", "NO_MATERIAL_OBJECTIONS"]},
    "resolutions": {"type": "array", "items": {"$ref": "#/$defs/resolution"}},
    "revision_batches": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["batch_id", "before_manuscript_sha256", "after_manuscript_sha256", "impact_path", "impact_sha256", "promotion_count", "cycle_ids"],
        "properties": {
          "batch_id": {"type": "string", "pattern": "^RB-[0-9]{3}$"},
          "before_manuscript_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "after_manuscript_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "impact_path": {"type": "string", "minLength": 1},
          "impact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "promotion_count": {"const": 1},
          "cycle_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^RC-[0-9]{3}$"}}
        }
      }
    },
    "review_cycles": {"type": "array", "items": {"type": "object"}},
    "optional_backlog": {"$ref": "#/$defs/idList"},
    "convergence": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "latest_cycle_id", "active_blocking_finding_keys", "root_cause_required_finding_keys"],
      "properties": {
        "status": {"enum": ["ACTIVE", "FROZEN", "ROOT_CAUSE_REQUIRED"]},
        "latest_cycle_id": {"type": ["string", "null"]},
        "active_blocking_finding_keys": {"$ref": "#/$defs/idList"},
        "root_cause_required_finding_keys": {"$ref": "#/$defs/idList"}
      }
    }
  },
  "$defs": {
    "idList": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "resolution": {
      "type": "object", "additionalProperties": false,
      "required": [
        "finding_id", "finding_key", "status", "decision", "original_severity", "final_severity",
        "earliest_reopen_stage", "adjudication", "merge_target_finding_id", "authorization",
        "change", "verification", "history", "reopen_count", "root_cause_analysis"
      ],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^REV-(MET|CON|CLR)-[0-9]{3}$"},
        "finding_key": {"type": "string", "pattern": "^RFK-[A-F0-9]{24}$"},
        "status": {"enum": ["OPEN", "PLANNED", "APPLIED", "VERIFIED", "MERGED", "REJECTED", "WAIVED", "REOPENED"]},
        "decision": {"enum": ["PENDING", "ACCEPTED", "MERGED", "REJECTED", "WAIVED"]},
        "original_severity": {"enum": ["CRITICAL", "MAJOR", "MINOR", "OBSERVATION"]},
        "final_severity": {"enum": ["CRITICAL", "MAJOR", "MINOR", "OBSERVATION"]},
        "earliest_reopen_stage": {"enum": ["research", "design", "execution", "build"]},
        "adjudication": {"type": ["object", "null"]},
        "merge_target_finding_id": {"type": ["string", "null"]},
        "authorization": {"type": ["object", "null"]},
        "change": {"type": ["object", "null"]},
        "verification": {"type": ["object", "null"]},
        "history": {"type": "array", "items": {"type": "object"}},
        "reopen_count": {"type": "integer", "minimum": 0},
        "root_cause_analysis": {"type": ["object", "null"]}
      }
    }
  }
}
