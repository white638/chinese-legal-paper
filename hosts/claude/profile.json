{
  "schema_version": "avereth-host-build-profile/v1",
  "host_id": "claude",
  "display_name": "Claude Code",
  "home_env": "CLAUDE_CONFIG_DIR",
  "default_home": ".claude",
  "python_env": "CLAUDE_PYTHON",
  "agent_format": "markdown",
  "agent_extension": ".md",
  "entrypoint_dir": "commands",
  "entrypoint_file": "avereth.md",
  "entrypoint_invocation": "/avereth",
  "skill_invocation": "cnki-paper",
  "openai_metadata": false,
  "default_runner": "claude-exec",
  "allowed_runners": [
    "claude-exec",
    "agent-declared"
  ],
  "permission_map": {
    "workspace_write": {},
    "read_only": {
      "tools": "Read"
    }
  },
  "template_tokens": {
    "HOST_EXEC_NAME": "ClaudeExec",
    "HOST_DISPLAY_NAME": "Claude Code",
    "BROWSER_TOOL_NAME": "chrome-devtools MCP",
    "SUBSKILL_ADAPTER_FILE": "claude-subskill-adapter.md",
    "METHOD_ADAPTER_FILE": "claude-method-adapter.md",
    "SKILL_INSTALL_ROOT": "~/.claude/skills",
    "RUNTIME_HOME_ASSIGNMENT": "$AverethHome = if ($env:CLAUDE_CONFIG_DIR) { $env:CLAUDE_CONFIG_DIR } else { Join-Path $HOME '.claude' }"
  },
  "template_fragments": {
    "SKILL_HOST_BOOTSTRAP": "fragments/skill-bootstrap.md",
    "HOST_RUNTIME_DOCUMENT": "fragments/host-runtime.md",
    "WORKFLOW_PYTHON_CANDIDATES": "fragments/workflow-python-candidates.md",
    "AGENT_DECLARED_AGENT_CLAUSE": "fragments/agent-declared-agent-clause.txt",
    "AGENT_DECLARED_SEMANTIC_CLAUSE": "fragments/agent-declared-semantic-clause.txt",
    "AGENT_DECLARED_ENTRYPOINT_GUIDANCE": "fragments/agent-declared-entrypoint.md",
    "AGENT_DECLARED_SKILL_GUIDANCE": "fragments/agent-declared-skill-guidance.md",
    "AGENT_DECLARED_SKILL_FOLLOWUP": "fragments/agent-declared-skill-followup.txt"
  },
  "reference_renames": [
    {
      "from": "skills/cnki-paper/references/host-subskill-adapter.source.md",
      "to": "skills/cnki-paper/references/claude-subskill-adapter.source.md"
    },
    {
      "from": "skills/empirical-research/references/host-method-adapter.source.md",
      "to": "skills/empirical-research/references/claude-method-adapter.source.md"
    }
  ],
  "rewrites": "rewrites.json",
  "discovery_channel": {
    "mode": "primary_search_broker",
    "allowed_tools": [
      "exa.search",
      "web.search"
    ],
    "direct_agent_tools": false,
    "context": "fresh_no_parent_history"
  }
}
